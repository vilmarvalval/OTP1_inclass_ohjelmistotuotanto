pipeline {
    agent any
    stages {
        stage('Checkout') {
            steps {
                git 'https://github.com/vilmarvalval/OTP1_inclass_ohjelmistotuotanto'
            }
        }
        stage('Build') {
            steps {
                bat 'sh mvn clean install' // sh for linux and ios
            }
        }
        stage('Test') {
            steps {
                bat 'sh mvn test'
            }
        }
        stage('Code Coverage') {
            steps {
                bat 'sh mvn jacoco:report'
            }
        }
        stage('Publish Test Results') {
            steps {
                junit '**/target/surefire-reports/*.xml'
            }
        }
        stage('Publish Coverage Report') {
            steps {
                jacoco()
            }
        }
    }
}